
AddOptionMenu "PB_AddonOptions"
{
    Submenu "$PBX_Armory_Settings", "PBX_Armory_Menu"
}

AddOptionMenu "PBXCore_Menu"
{
    StaticText	"--------- PBX Armory Settings ---------", 1
    Option  "$PBX_ARMORY_MENU_ENABLE_TOOLTIPS", "PBX_Armory_SendTip", "OnOff","PBXCore_SendTip"
    SafeCommand "$PBX_ARMORY_MENU_RESET_SPAWNERS", "resetcvar PBX_Armory_powerupfilter; resetcvar PBX_Armory_itemFilter; resetcvar PBX_Armory_armorFilter"
    SafeCommand "$PBX_ARMORY_MENU_RESET_TOOLTIPS", "resetcvar PBX_Armory_powerupHelpFlags; resetcvar PBX_Armory_itemHelpFlags; resetcvar PBX_Armory_armorHelpFlags"
    SafeCommand "$PBX_POWERUPS_MENU_RESET_DURATIONS", "resetcvar PBX_Armory_goldinv_duration; resetcvar PBX_Armory_terror_duration; resetcvar PBX_Armory_infammo_duration; resetcvar PBX_Armory_timefreeze_duration; resetcvar PBX_Armory_adrenaline_duration"
    SafeCommand "$PBX_ARMORS_MENU_RESET_DURATIONS", "resetcvar PBX_Armors_White_duration; resetcvar PBX_Armors_Demon_duration; resetcvar PBX_Armors_Cyan_duration; resetcvar PBX_Armors_DPurple_duration; resetcvar PBX_Armors_LGreen_duration; resetcvar PBX_Armors_Debuff_duration"
    StaticText "$PBX_Armory_Version",orange
    StaticText " "
}

OptionMenu "PBX_Armory_Menu"
{
    Title "$PBX_Armory_Settings"
	Class "PB_OptionMenu"
    Position	-48

    StaticText	"--------- General Settings ---------", 1
    Option  "$PBX_ARMORY_MENU_ENABLE_TOOLTIPS", "PBX_Armory_SendTip", "OnOff","PBXCore_SendTip"
    SafeCommand "$PBX_ARMORY_MENU_RESET_SPAWNERS", "resetcvar PBX_Armory_powerupfilter; resetcvar PBX_Armory_itemFilter; resetcvar PBX_Armory_armorFilter;"
    SafeCommand "$PBX_ARMORY_MENU_RESET_TOOLTIPS", "resetcvar PBX_Armory_powerupHelpFlags; resetcvar PBX_Armory_itemHelpFlags; resetcvar PBX_Armory_armorHelpFlags"
    StaticText " "
    StaticText	"--------- PBX Items Settings ---------", 1
    Option "$PBX_ITEMS_START_WITH_SHOULDERCANNON",   "PBX_Items_ShouldCanStart", "OnOff","PBXCore_GlorykillLoaded",1,1
    Option  "$PBX_ITEMS_SHOULDCANNON_USEAMMO",       "PBX_Items_ShouldCanUseAmmo", "OnOff"
    Slider "$PBX_ITEMS_FLAMEBELCHAMMOUSE",           "PBX_Items_FlameBelchAmmoUse",     1, 500, 1
    Slider "$PBX_ITEMS_ICEBOMBAMMOUSE",              "PBX_Items_IceBombAmmoUse",        1, 500, 1
    Slider "$PBX_ITEMS_JETPACKFUELUSE",              "PBX_Items_JetPackFuelUse",        1, 500, 1
    StaticText " "
    StaticText	"--------- PBX Powerups Settings ---------", 1
    Slider "$PBX_POWERUPS_GOLDINV_DURATION",             "PBX_Powerups_GoldInv_duration",        1, 500, 1
    Slider "$PBX_POWERUPS_TERROR_DURATION",              "PBX_Powerups_Terror_duration",         1, 500, 1
    Slider "$PBX_POWERUPS_INFAMMO_DURATION",             "PBX_Powerups_Infammo_duration",        1, 500, 1
    Slider "$PBX_POWERUPS_TIMEFREEZE_DURATION",          "PBX_Powerups_Timefreeze_duration",     1, 500, 1
    Slider "$PBX_POWERUPS_ADRENALINE_DURATION",          "PBX_Powerups_Adrenaline_duration",     1, 500, 1
    SafeCommand "$PBX_POWERUPS_MENU_RESET_DURATIONS", "resetcvar PBX_Powerups_GoldInv_duration; resetcvar PBX_Powerups_Terror_duration; resetcvar PBX_Powerups_Infammo_duration; resetcvar PBX_Powerups_Timefreeze_duration; resetcvar PBX_Powerups_Adrenaline_duration"
    StaticText " "
    StaticText	"--------- PBX Armors Settings ---------", 1
    Slider "$PBX_ARMORS_WHITE_DURATION",               "PBX_Armors_White_duration",    1, 500, 1
    Slider "$PBX_ARMORS_DEMON_DURATION",               "PBX_Armors_Demon_duration",    1, 500, 1
    Slider "$PBX_ARMORS_CYAN_DURATION",                "PBX_Armors_Cyan_duration",     1, 500, 1
    Slider "$PBX_ARMORS_DPURPLE_DURATION",             "PBX_Armors_DPurple_duration",  1, 500, 1
    Slider "$PBX_ARMORS_LGREEN_DURATION",              "PBX_Armors_LGreen_duration",   1, 500, 1
    Slider "$PBX_ARMORS_PINK_DURATION",                "PBX_Armors_Debuff_duration",   1, 500, 1
    SafeCommand "$PBX_ARMORS_MENU_RESET_DURATIONS", "resetcvar PBX_Armors_White_duration; resetcvar PBX_Armors_Demon_duration; resetcvar PBX_Armors_Cyan_duration; resetcvar PBX_Armors_DPurple_duration; resetcvar PBX_Armors_LGreen_duration; resetcvar PBX_Armors_Debuff_duration"

    StaticText " "
    StaticText "$PBX_Armory_Version",orange
}

