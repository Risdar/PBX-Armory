
AddOptionMenu "PB_AddonOptions"
{
    Submenu "$PBX_Armory_Settings", "PBX_Armory_Menu"
}

AddOptionMenu "PBXCore_Menu"
{
    StaticText	"--------- PBX Armory Settings ---------", 1
    Option  "$PBX_ARMORY_MENU_ENABLE_TOOLTIPS", "PBX_Armory_SendTip", "OnOff","PBXCore_SendTip"
    SafeCommand "$PBX_ARMORY_MENU_RESET_SPAWNERS", "resetcvar PBX_Powerups_Filter; resetcvar PBX_Items_Filter; resetcvar PBX_Armors_Filter"
    SafeCommand "$PBX_ARMORY_MENU_RESET_TOOLTIPS", "resetcvar PBX_Armory_powerupHelpFlags; resetcvar PBX_Armory_itemHelpFlags; resetcvar PBX_Armory_armorHelpFlags"
    SafeCommand "$PBX_POWERUPS_MENU_RESET_DURATIONS", "resetcvar PBX_Armory_goldinv_duration; resetcvar PBX_Armory_terror_duration; resetcvar PBX_Armory_infammo_duration; resetcvar PBX_Armory_timefreeze_duration; resetcvar PBX_Armory_adrenaline_duration"
    SafeCommand "$PBX_ARMORS_MENU_RESET_DURATIONS", "resetcvar PBX_WhiteArmor_duration; resetcvar PBX_DemonArmor_duration; resetcvar PBX_CyanArmor_duration; resetcvar PBX_DPurpleArmor_duration; resetcvar PBX_LGreenArmor_duration; resetcvar PBX_PinkDebuff_duration"
    StaticText "$PBX_Armory_Version",orange
    StaticText " "
}

OptionMenu "PBX_Armory_Menu"
{
    Title "$PBX_Armory_Settings"
	Class "PB_OptionMenu"
    Position	-48

    StaticText	"--------- General Settings ---------", 1
    Option  "$PBX_ARMORY_MENU_ENABLE_TOOLTIPS", "PBX_Armory_SendTip", "OnOff","PBXCore_SendTip"
    SafeCommand "$PBX_ARMORY_MENU_RESET_SPAWNERS", "resetcvar PBX_Powerups_Filter; resetcvar PBX_Items_Filter; resetcvar PBX_Armors_Filter;"
    SafeCommand "$PBX_ARMORY_MENU_RESET_TOOLTIPS", "resetcvar PBX_Armory_powerupHelpFlags; resetcvar PBX_Armory_itemHelpFlags; resetcvar PBX_Armory_armorHelpFlags"
    StaticText " "
    StaticText	"--------- PBX Items Settings ---------", 1
    FlagOption  "$PBX_ITEMS_SMARTSCAV_ENABLE",              "PBX_Items_Filter",    "OffOn", 4
    Option      "$PBX_ITEMS_START_WITH_SHOULDERCANNON",     "PBX_Items_ShouldCanStart", "OnOff", "PBXCore_GlorykillLoaded",1,1
    Option      "$PBX_ITEMS_SHOULDCANNON_USEAMMO",          "PBX_SC_UseAmmo", "OnOff"
    Slider      "$PBX_SC_FlameBelchAmmoUse",                "PBX_SC_FlameBelchAmmoUse",    1, 500, 1
    Slider      "$PBX_SC_IceBombAmmoUse",                    "PBX_SC_IceBombAmmoUse",      1, 500, 1
    Slider      "$PBX_JetPack_FuelUse",                      "PBX_JetPack_FuelUse",        1, 500, 1
    SafeCommand "$PBX_ITEMS_MENU_RESET_SETTINGS", "set PBX_Items_Filter 0; resetcvar PBX_Items_ShouldCanStart; resetcvar PBX_SC_UseAmmo; resetcvar PBX_SC_FlameBelchAmmoUse; resetcvar PBX_SC_IceBombAmmoUse; resetcvar PBX_JetPack_FuelUse;"
    StaticText " "
    StaticText	"--------- PBX Powerups Settings ---------", 1
    Slider "$PBX_POWERUPS_GOLDINV_DURATION",          "pbx_goldinv_duration",     1, 500, 1
    Slider "$PBX_POWERUPS_TAINTED_INVISIBILITY",      "pbx_invistaint_duration",  1, 500, 1
    Slider "$PBX_POWERUPS_DEFLECT",                   "pbx_deflect_duration",     1, 500, 1
    Slider "$PBX_POWERUPS_ELECTRIC_AURA",             "pbx_electaura_duration",   1, 500, 1
    Slider "$PBX_POWERUPS_BUDDHA",                    "pbx_buddha_duration",      1, 500, 1
    Slider "$PBX_POWERUPS_DRAIN",                     "pbx_drain_duration",       1, 500, 1
    Slider "$PBX_POWERUPS_FLIGHT",                    "pbx_flight_duration",      1, 500, 1
    Slider "$PBX_POWERUPS_TERROR_DURATION",           "pbx_terror_duration",      1, 500, 1
    Slider "$PBX_POWERUPS_HIGH_JUMP",                 "pbx_highjump_duration",    1, 500, 1
    Slider "$PBX_POWERUPS_INFINITE_AMMO",             "pbx_infammo_duration",     1, 500, 1
    Slider "$PBX_POWERUPS_PROTECTION",                "pbx_protect_duration",     1, 500, 1
    Slider "$PBX_POWERUPS_REFLECTION",                "pbx_reflect_duration",     1, 500, 1
    Slider "$PBX_POWERUPS_REGENERATION",              "pbx_regen_duration",       1, 500, 1
    Slider "$PBX_POWERUPS_TIME_FREEZE",               "pbx_timefreeze_duration",  1, 500, 1
    Slider "$PBX_POWERUPS_TAINTED_REGENERATION",      "pbx_taintregen_duration",  1, 500, 1
    Slider "$PBX_POWERUPS_FROST_AURA",                "pbx_frostaura_duration",   1, 500, 1
    Slider "$PBX_POWERUPS_FIRE_AURA",                 "pbx_fireaura_duration",    1, 500, 1
    Slider "$PBX_POWERUPS_ADRENALINE_DURATION",       "pbx_adrenaline_duration",  1, 500, 1
    SafeCommand "$PBX_POWERUPS_MENU_RESET_DURATIONS", "resetcvar pbx_adrenaline_duration; resetcvar pbx_invistaint_duration; resetcvar pbx_deflect_duration; resetcvar pbx_electaura_duration; resetcvar pbx_goldinv_duration; resetcvar pbx_buddha_duration; resetcvar pbx_drain_duration; resetcvar pbx_flight_duration; resetcvar pbx_terror_duration; resetcvar pbx_highjump_duration; resetcvar pbx_infammo_duration; resetcvar pbx_protect_duration; resetcvar pbx_reflect_duration; resetcvar pbx_regen_duration; resetcvar pbx_timefreeze_duration; resetcvar pbx_taintregen_duration; resetcvar pbx_frostaura_duration; resetcvar pbx_fireaura_duration"

    StaticText " "
    StaticText	"--------- PBX Armors Settings ---------", 1
    FlagOption "$PBX_ARMORS_HELMETDROPS_ENABLE",      "PBX_Armors_Filter",   "OffOn", 15
    Slider "$PBX_WhiteArmor_duration",               "PBX_WhiteArmor_duration",    1, 500, 1
    Slider "$PBX_DemonArmor_duration",               "PBX_DemonArmor_duration",    1, 500, 1
    Slider "$PBX_CyanArmor_duration",                "PBX_CyanArmor_duration",     1, 500, 1
    Slider "$PBX_DPurpleArmor_duration",             "PBX_DPurpleArmor_duration",  1, 500, 1
    Slider "$PBX_LGreenArmor_duration",              "PBX_LGreenArmor_duration",   1, 500, 1
    Slider "$PBX_ARMORS_PINK_DURATION",               "PBX_PinkDebuff_duration",   1, 500, 1
    SafeCommand "$PBX_ARMORS_MENU_RESET_DURATIONS", "resetcvar PBX_WhiteArmor_duration; resetcvar PBX_DemonArmor_duration; resetcvar PBX_CyanArmor_duration; resetcvar PBX_DPurpleArmor_duration; resetcvar PBX_LGreenArmor_duration; resetcvar PBX_PinkDebuff_duration"

    StaticText " "
    StaticText "$PBX_Armory_Version",orange
}

